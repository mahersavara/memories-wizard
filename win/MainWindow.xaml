<Window x:Class="MemoriesWizard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MemoriesWizard"
        mc:Ignorable="d"
        Title="Memories Wizard" Height="700" Width="1000"
        Icon="Resources/icon.png"
        WindowStartupLocation="CenterScreen"
        Background="Transparent" AllowsTransparency="True" WindowStyle="None">
    
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="50" 
                      ResizeBorderThickness="8" 
                      GlassFrameThickness="0" 
                      CornerRadius="30"/>
    </WindowChrome.WindowChrome>
    
    <Grid>
        <!-- Background Layer (Vibrant Gradient to make glass pop) -->
        <Border CornerRadius="30" Margin="10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#E8F5E9" Offset="0.0"/> <!-- Light Sage -->
                    <GradientStop Color="#C8E6C9" Offset="0.5"/>
                    <GradientStop Color="#A5D6A7" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" Direction="-90" RenderingBias="Quality" ShadowDepth="5" Opacity="0.4"/>
            </Border.Effect>
        </Border>

        <!-- Main Glass Panel -->
        <Border Style="{StaticResource GlassCardStyle}" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Custom Title Bar -->
                <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent" Height="50">
                    <TextBlock Text="Memories Wizard" Foreground="{StaticResource BrushDeepForest}" VerticalAlignment="Center" Margin="25,0,0,0" FontSize="14" FontWeight="SemiBold" Opacity="0.7"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,15,0">
                        <Button Content="—" Click="Minimize_Click" Style="{StaticResource NatureButtonStyle}" Background="Transparent" Foreground="{StaticResource BrushDeepForest}" FontSize="18" Padding="15,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnMaximize" Content="▢" Click="Maximize_Click" Style="{StaticResource NatureButtonStyle}" Background="Transparent" Foreground="{StaticResource BrushDeepForest}" FontSize="16" Padding="15,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="✕" Click="Close_Click" Style="{StaticResource NatureButtonStyle}" Background="Transparent" Foreground="{StaticResource BrushDeepForest}" FontSize="18" Padding="15,0" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>

                <!-- Main Content Area -->
                <Grid Grid.Row="1" Margin="50">
                    <!-- Menu Screen -->
                    <StackPanel x:Name="MenuScreen" VerticalAlignment="Center" MaxWidth="600">
                        <TextBlock Text="Sort Your Journey" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,50"/>
                        
                        <Border Background="#33FFFFFF" CornerRadius="15" Padding="20" Margin="0,0,0,25" BorderThickness="1" BorderBrush="#22000000">
                            <StackPanel>
                                <TextBlock Text="Source Library" Foreground="{StaticResource BrushDeepForest}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Opacity="0.6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSourcePath" IsReadOnly="True" Padding="12" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Select" Click="BrowseSource_Click" Style="{StaticResource NatureButtonStyle}" Padding="15,8"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="2,5,0,0">
                                    <CheckBox x:Name="ChkRecursive" Content="Scan Subfolders" VerticalAlignment="Center" Foreground="{StaticResource BrushDeepForest}" Opacity="0.7" IsChecked="True" Checked="ChkRecursive_Changed" Unchecked="ChkRecursive_Changed"/>
                                    <TextBlock x:Name="TxtMediaCount" Text="0 files discovered" Foreground="{StaticResource BrushDeepForest}" FontSize="11" VerticalAlignment="Center" Margin="15,0,0,0" Opacity="0.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#33FFFFFF" CornerRadius="15" Padding="20" Margin="0,0,0,40" BorderThickness="1" BorderBrush="#22000000">
                            <StackPanel>
                                <TextBlock Text="Destination Collection" Foreground="{StaticResource BrushDeepForest}" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" Opacity="0.6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtDestPath" IsReadOnly="True" Padding="12" Background="Transparent" BorderThickness="0" FontSize="14" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="1" Content="Select" Click="BrowseDest_Click" Style="{StaticResource NatureButtonStyle}" Padding="15,8"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Content="Begin Sorting" Click="Start_Click" Style="{StaticResource NatureButtonStyle}" HorizontalAlignment="Center" Width="220" Height="55" FontSize="18"/>
                    </StackPanel>
                    
                    <!-- Media Screen -->
                    <Grid x:Name="MediaScreen" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Media Container with Perspective/Glass Effect -->
                        <Border x:Name="MediaContainer" Background="Black" CornerRadius="20" ClipToBounds="True" 
                                MouseLeftButtonDown="MediaContainer_MouseLeftButtonDown" 
                                MouseMove="MediaContainer_MouseMove" 
                                MouseLeftButtonUp="MediaContainer_MouseLeftButtonUp"
                                RenderTransformOrigin="0.5,0.8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="10" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Image x:Name="ImgPreview" Stretch="Uniform"/>
                                <MediaElement x:Name="VidPreview" Stretch="Uniform" LoadedBehavior="Manual" UnloadedBehavior="Stop" ScrubbingEnabled="True" IsMuted="False" Volume="0.5"/>
                                
                                <!-- Video Controls Overlay -->
                                <Border x:Name="VidControls" VerticalAlignment="Bottom" Background="#AA000000" CornerRadius="0,0,20,20" Padding="15,10" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Seek Slider -->
                                        <Slider x:Name="SldSeek" Grid.Row="0" Margin="0,0,0,5" Minimum="0" Maximum="1" 
                                                Thumb.DragStarted="SldSeek_DragStarted" Thumb.DragCompleted="SldSeek_DragCompleted" 
                                                ValueChanged="SldSeek_ValueChanged" Cursor="Hand"/>
                                        
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Time Display -->
                                            <TextBlock x:Name="TxtVidTime" Text="00:00 / 00:00" Foreground="White" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            
                                            <!-- Volume Icon/Slider -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <TextBlock Text="🔈" Foreground="White" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <Slider x:Name="SldVolume" Width="80" Minimum="0" Maximum="1" Value="0.5" ValueChanged="SldVolume_ValueChanged" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- Speed Selector -->
                                            <ComboBox Grid.Column="3" x:Name="CmbSpeed" Width="70" SelectedIndex="2" SelectionChanged="CmbSpeed_SelectionChanged" 
                                                      Background="Transparent" Foreground="Black" FontSize="11">
                                                <ComboBoxItem Content="0.5x"/>
                                                <ComboBoxItem Content="0.75x"/>
                                                <ComboBoxItem Content="1.0x"/>
                                                <ComboBoxItem Content="1.25x"/>
                                                <ComboBoxItem Content="1.5x"/>
                                                <ComboBoxItem Content="2.0x"/>
                                            </ComboBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                            <Border.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="MediaTransform" X="0" Y="0"/>
                                    <RotateTransform x:Name="MediaRotate" Angle="0"/>
                                </TransformGroup>
                            </Border.RenderTransform>
                        </Border>

                        <!-- Swipe Overlays -->
                        <TextBlock x:Name="TxtIndicator" Text="SKIP" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="80" FontWeight="Black" Foreground="White" Opacity="0">
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="10" Color="Black" Opacity="0.5"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Footer Control -->
                        <Grid Grid.Row="1" Margin="0,30,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtFileName" Text="unnamed_media.jpg" Foreground="{StaticResource BrushDeepForest}" FontSize="16" FontWeight="SemiBold"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="Complete Now" Click="CompleteNow_Click" Style="{StaticResource NatureButtonStyle}" Background="#44000000" Padding="15,5" FontSize="14"/>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBox x:Name="TxtCurrentIndex" Text="0" Width="40" TextAlignment="Center" Padding="2" Background="#33FFFFFF" BorderBrush="#22000000" BorderThickness="1" Foreground="{StaticResource BrushDeepForest}" KeyDown="TxtCurrentIndex_KeyDown"/>
                                <TextBlock x:Name="TxtTotalCount" Text=" / 0" Foreground="{StaticResource BrushDeepForest}" Opacity="0.6" VerticalAlignment="Center" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Success Screen -->
                    <StackPanel x:Name="SuccessScreen" Visibility="Collapsed" VerticalAlignment="Center">
                        <TextBlock Text="Journey Organized" Style="{StaticResource HeaderTextStyle}" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                        <TextBlock Text="All your memories are now in their place." HorizontalAlignment="Center" Foreground="{StaticResource BrushDeepForest}" Margin="0,0,0,20" Opacity="0.7"/>
                        
                        <TextBlock x:Name="TxtSummary" Text="Kept: 0 | Skipped: 0 | Trashed: 0" HorizontalAlignment="Center" Foreground="{StaticResource BrushDeepForest}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,50"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Restart" Click="BackToMenu_Click" Style="{StaticResource NatureButtonStyle}" Width="160" Margin="0,0,20,0" Background="#44000000"/>
                            <Button Content="View Collection" Click="OpenDest_Click" Style="{StaticResource NatureButtonStyle}" Width="200"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
